# Copy this file to .env and fill in your real values
# Never commit private secrets to version control

# ========================================
# BACKEND / DATABASE CONFIGURATION
# ========================================

# Supabase public client configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ========================================
# AI CONFIGURATION
# ========================================

# Primary AI provider for criteria generation
# Options: openrouter, groq
VITE_AI_CRITERIA_PROVIDER=openrouter

# OpenRouter API Key (supports multiple models)
VITE_OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Groq API Key (optional fallback, faster/cheaper)
VITE_GROQ_API_KEY=gsk-your-groq-key-here

# AI Model selection (for OpenRouter or direct API calls)
# Recommended: gpt-4o-mini (cost-effective), gpt-4-turbo, claude-3-haiku, or llama-2-70b
VITE_AI_CRITERIA_MODEL=openai/gpt-4o-mini
VITE_AI_CHATBOT_MODEL=openai/gpt-4o-mini

# ========================================
# APP CONFIGURATION
# ========================================

# Enable demo mode (uses seed users, no real auth)
# Set to false once Supabase tables are ready and you want app data to persist
VITE_DEMO_MODE=false

# ========================================
# NOTES
# ========================================
# 1. For production, never expose API keys in the frontend.
#    Instead, create a backend proxy that handles all API requests.
# 2. The app will gracefully fall back to local generation if AI APIs are unavailable.
# 3. Demo mode allows testing without real API calls.
